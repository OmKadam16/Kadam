kadam 0.3

page "Shop" {
    intro {
        a main heading
        the text says "Shop"
    }
    catalog {
        a container
        it loads products from the server function listProducts
        while loading, it shows loadingNote
        when there are none, it shows emptyNote
        when loading fails, it shows errorNote
        tile {
            an ItemCard for each product in products
            only where the inStock of product is true
            sorted by the price of product from highest to lowest
            with a name of the name of product
            with a price of the price of product
        }
        loadingNote {
            a paragraph
            the text says "Loading products..."
        }
        emptyNote {
            a paragraph
            the text says "Nothing is in stock."
        }
        errorNote {
            a paragraph
            the text says "The products could not be loaded."
        }
    }
    signupForm {
        a form
        it sends to the server function signUp
        when it is sent, it shows thanksNote
        when sending fails, it shows sorryNote
        address {
            a text field
            the label says "Email"
            it accepts email addresses
            it is required
        }
        plan {
            a dropdown
            the label says "Plan"
            the options are "Free", "Pro"
        }
        seats {
            a text field
            the label says "Seats"
            it accepts numbers
            it is required
        }
        news {
            a checkbox
            the label says "Send me news"
        }
        join {
            a button
            the text says "Sign up"
            it submits the form
        }
        thanksNote {
            a paragraph
            the text says "Thanks, you are signed up."
        }
        sorryNote {
            a paragraph
            the text says "Sorry, that did not work. Try again."
        }
    }
}
