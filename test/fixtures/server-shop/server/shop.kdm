kadam 0.2

module shop {
    record Product {
        name as text
        category as text
        price as number
        inStock as boolean
    }

    record Signup {
        address as text
        plan as text
        news as boolean
        seats as number
    }

    function signUp takes signup as Signup and returns nothing {
        output "signup: " + signup.address + " (" + signup.plan + ")"
        output signup.seats * 2
    }

    function listProducts takes nothing and returns list of Product {
        return [Product { name: "Lamp", category: "lighting", price: 40, inStock: true }, Product { name: "Desk", category: "furniture", price: 250, inStock: true }, Product { name: "Chair", category: "furniture", price: 120, inStock: false }, Product { name: "Shelf", category: "furniture", price: 90, inStock: true }]
    }
}
