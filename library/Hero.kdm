kadam 0.3

// The top of a landing page: the page's main heading, a lead, and one action.
component Hero takes a title as text, a lead as text, an action as text, a target as page, an accent as color defaulting to "#4F46E5" {
    hero1 {
        a section
        it has 80px padding on the top and bottom
        it has 24px padding on the left and right
        on phones, it has 48px padding on the top and bottom
        it has 20px gap between children
        its children fade in one after another
        title1 {
            a main heading
            the text says "{$title}"
            the text is between 2.25rem and 3.75rem
            the text is at most 20 characters wide
        }
        lead1 {
            a paragraph
            the text says "{$lead}"
            the text is 20px
            the text is at most 60 characters wide
        }
        action1 {
            a button
            the text says "{$action}"
            has a "{$accent}" background
            has fully rounded corners
            when hovered, it lifts by 2px
            when clicked, go to page "{$target}"
        }
        extra1 {
            a slot
        }
    }

    variant centered {
        hero1 {
            a section
            it has 80px padding on the top and bottom
            it has 24px padding on the left and right
            on phones, it has 48px padding on the top and bottom
            it has 20px gap between children
            it centers its children
            its children fade in one after another
            title1 {
                a main heading
                the text says "{$title}"
                the text is centered
                the text is between 2.25rem and 3.75rem
                the text is at most 20 characters wide
            }
            lead1 {
                a paragraph
                the text says "{$lead}"
                the text is centered
                the text is 20px
                the text is at most 60 characters wide
            }
            action1 {
                a button
                the text says "{$action}"
                has a "{$accent}" background
                has fully rounded corners
                when hovered, it lifts by 2px
                when clicked, go to page "{$target}"
            }
            extra1 {
                a slot
            }
        }
    }
}
