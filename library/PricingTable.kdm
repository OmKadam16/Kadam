kadam 0.3

// A section of PricingPlans side by side, stacked on phones.
component PricingTable takes a title as text {
    section1 {
        a section
        it has 64px padding on the top and bottom
        it has 24px padding on the left and right
        it has 32px gap between children
        title1 {
            a section heading
            the text says "{$title}"
        }
        plans1 {
            a container
            it arranges its children in 3 columns
            on phones, it arranges its children in 1 column
            it has 24px gap between children
            items1 {
                a slot
            }
        }
    }
}
