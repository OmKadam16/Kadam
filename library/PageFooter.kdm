kadam 0.3

// The bottom of every page: a note, and links in the slot.
component PageFooter takes a note as text {
    footer1 {
        a footer
        it has 32px padding on the top and bottom
        it has 24px padding on the left and right
        it has 12px gap between children
        has a 1px #6B728040 border on the top
        links1 {
            a container
            it arranges its children in a row
            it has 16px gap between children
            it wraps its children
            items1 {
                a slot
            }
        }
        note1 {
            a paragraph
            the text says "{$note}"
            the text is 14px
        }
    }
}
