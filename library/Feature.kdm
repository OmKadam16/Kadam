kadam 0.3

// One feature: a short title and a sentence or two.
component Feature takes a title as text, a body as text {
    feature1 {
        a container
        it has 8px gap between children
        title1 {
            a minor heading
            the text says "{$title}"
        }
        body1 {
            a paragraph
            the text says "{$body}"
        }
    }
}
