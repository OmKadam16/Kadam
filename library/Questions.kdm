kadam 0.3

// A section of frequently asked questions. Fill it with Questions.
component Questions takes a title as text {
    section1 {
        a section
        it has 64px padding on the top and bottom
        it has 24px padding on the left and right
        it has 24px gap between children
        title1 {
            a section heading
            the text says "{$title}"
        }
        list1 {
            a container
            it is at most 720px wide
            items1 {
                a slot
            }
        }
    }
}
