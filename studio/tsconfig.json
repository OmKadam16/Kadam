{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "noEmit": true,
    "types": ["vite/client", "node"]
  },
  "include": [
    "src/web/**/*.ts",
    "src/web/**/*.tsx",
    "src/shared/**/*.ts",
    "vite.config.ts"
  ]
}
