{
  "name": "kadam",
  "version": "0.1.0",
  "type": "module",
  "description": "A deterministic, natural-language compiler evolving from declarative UI toward multi-target code generation.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OmKadam16/Kadam.git"
  },
  "homepage": "https://github.com/OmKadam16/Kadam#readme",
  "bugs": {
    "url": "https://github.com/OmKadam16/Kadam/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.18"
  },
  "bin": {
    "kadam": "dist/cli/main.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "library"
  ],
  "scripts": {
    "prebuild": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test test/*.test.mjs",
    "check": "npm run typecheck && npm test",
    "prepack": "npm run build",
    "probes": "npm run build && node test/helpers/probe-report.mjs",
    "test:browser": "npm run build && playwright test -c test/browser/playwright.config.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^22.0.0",
    "axe-core": "^4.14.1",
    "jsdom": "^31.0.1",
    "typescript": "^5.9.3"
  }
}
