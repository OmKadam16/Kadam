                the text says "Harbor"
                the text is 16px
                the text is #8D8C87
            }
            logoSix {
                a paragraph
                the text says "Framewise"
                the text is 16px
                the text is #8D8C87
            }
        }
        quotes {
            a container
            it is full width
            it is at most 1320px wide
            it is centered
            it arranges its children in columns at least 250px wide
            it has 8px gap between children
            quoteOne {
                a Quote
                with a person of "Nadia"
                with a handle of "@nadia_builds · Nov 2, 2026"
                with a body of "Just tried Lumen and wow. It is what every coding bot should have been."
            }
            quoteTwo {
                a Quote
                with a person of "Joel Hart"
                with a handle of "@joelhart · Nov 2, 2026"
                with a body of "Living the dream: Lumen on my laptop, driving my desktop over SSH with my own subscription."
            }
            quoteThree {
                a Quote
                with a person of "Yara"
                with a handle of "@yara_writes · Oct 25, 2026"
                with a body of "My ranking of AI software engineers: 1. Lumen. 2. Everything else."
            }
            quoteFour {
                a Quote
                with a person of "Colin"
                with a handle of "@colin_ex · Oct 21, 2026"
                with a body of "It came back with 9 real issues. Every one had steps, a screenshot and a fix."
            }
        }
    }

    bench {
        a section
        it has 64px padding on the top and bottom
        it has 24px padding on the left and right
        it has 32px gap between children
        it remembers suite, a text that starts as "terminal"
        benchTitle {
            a section heading
            the letter spacing is -1.1px
            the text says "Lumen is frontier while being the absolute cheapest."
            the text is between 2rem and 2.75rem
            the text weight is 420
            the text is #111110
            the line height is 1.1
            it is full width
            it is at most 1320px wide
            it is centered
        }
        chart {
