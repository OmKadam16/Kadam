kadam 0.3

// A Kadam replica of an AI-agent product landing page, built to test how
// close the language gets to a real, polished design. Brand, people and
// company names are stand-ins.
page "Lumen Machines" {
    the page description says "Lumen helps your AI agents work together, for less."
    the page background is #FCFCFC
    the page text is #1C1C1C
    the page font is sans serif

    banner {
        a container
        it is full width
        has a #000000 background
        it has 6px padding on the top and bottom
        it arranges its children in a row
        it centers its children horizontally
        it centers its children vertically
        it has 6px gap between children
        bannerMark {
            a paragraph
            the text says "Y"
            the text is 9px
            the text is bold
            the text is #FFFFFF
            has a #F26522 background
            it has 1px padding on the top and bottom
            it has 3px padding on the left and right
        }
        bannerText {
            a paragraph
            the text says "Backed by a startup accelerator (F26)"
            the text is 12px
            the text is #FFFFFF
        }
    }

    siteHeader {
        a header
        it sticks to the top
        the layer is 20
        has a #FCFCFCE6 background
        it blurs the background behind it by 8px
        it has 12px padding on the top and bottom
        it has 24px padding on the left and right
        headerRow {
            a container
            it is full width
            it is at most 1320px wide
            it is centered
            it arranges its children in a row
            it spreads its children apart
            it centers its children vertically
            brandRow {
                a container
                it arranges its children in a row
                it centers its children vertically
                it has 10px gap between children
                brandDot {
                    a container
                    it is 13px wide
                    it is 13px tall
                    has fully rounded corners
                    has a #111110 background
                }
                brandName {
                    a paragraph
                    the text says "Lumen Machines"
                    the text is 16px
                    the text is #111110
                }
            }
            startButton {
                a button
                the text says "Get started"
                the text is 15px
                the text weight is 420
                has a #111110 background
                has fully rounded corners
                it has 10px padding on the top and bottom
                it has 18px padding on the left and right
                when hovered, the background turns #3A3A38
                when clicked, go to "closing"
            }
        }
    }

    hero {
        a section
        it has 96px padding on the top
        it has 24px padding on the left and right
        it has 40px padding on the bottom
        it has 22px gap between children
        heroTitle {
            a main heading
            the letter spacing is -1.32px
            the text says "Meet Lumen, the most effective agent you can run."
            the text is between 2rem and 2.75rem
            the text weight is 420
            the text is #111110
            the line height is 1.08
            it is full width
            it is at most 1320px wide
            it is centered
        }
        heroLead {
            a paragraph
            the text says "Lumen helps you get the most out of AI for the least spend."
            the text is 19px
            the text is #62615D
            the line height is 1.5
            it is full width
            it is at most 1320px wide
            it is centered
        }
        heroActions {
            a container
            it is full width
            it is at most 1320px wide
            it is centered
            it has 10px padding on the top
            downloadButton {
                a button
                the text says "Download for macOS"
                the text is 17px
                the text weight is 420
                has a #111110 background
                has fully rounded corners
                it has 15px padding on the top and bottom
                it has 22px padding on the left and right
                when hovered, the background turns #3A3A38
                when pressed, it scales to 98%
                when clicked, go to "closing"
            }
        }

        appWindow {
            a container

            it stretches its children
            it is full width
            it is at most 1320px wide
            it is centered
            it is 560px tall
            has a #FFFFFF background
            has a 1px #E6E5E1 border
            has 10px rounded corners
            has a soft shadow
            it hides overflow
            it arranges its children in a row
            it has 34px margin on the top
            on phones, it is hidden

            sidebar {
                a container
                it stretches its children

                it is 300px wide
                it does not shrink
                has a #F7F7F5 background
                has a 1px #E6E5E1 border on the right
                it has 14px padding
                it has 2px gap between children
                lights {
                    a container
                    it arranges its children in a row
                    it has 7px gap between children
                    it has 14px padding on the bottom
                    lightStop {
                        a container
                        it is 12px wide
                        it is 12px tall
                        has fully rounded corners
                        has a #FF5F57 background
                    }
                    lightWait {
                        a container
                        it is 12px wide
                        it is 12px tall
                        has fully rounded corners
                        has a #FEBC2E background
                    }
                    lightGo {
                        a container
                        it is 12px wide
                        it is 12px tall
                        has fully rounded corners
                        has a #28C840 background
                    }
                }
                navNew {
                    a paragraph
                    the line height is 1.3
                    the text says "+  New"
                    the text is 13px
                    the text is #111110
                    it has 5px padding on the top and bottom
                    it has 8px padding on the left and right
                }
                navSearch {
                    a paragraph
                    the line height is 1.3
                    the text says "Search"
                    the text is 13px
                    the text is #111110
                    it has 5px padding on the top and bottom
                    it has 8px padding on the left and right
                }
                navAutomations {
                    a paragraph
                    the line height is 1.3
                    the text says "Automations"
                    the text is 13px
                    the text is #111110
                    it has 5px padding on the top and bottom
                    it has 8px padding on the left and right
                }
                navCustomize {
                    a paragraph
                    the line height is 1.3
                    the text says "Customize"
                    the text is 13px
                    the text is #111110
                    it has 5px padding on the top and bottom
                    it has 8px padding on the left and right
                }
                groupLabel {
                    a paragraph
                    the text says "Agents"
                    the text is 11px
                    the text is #8D8C87
                    it has 10px padding on the top
                    it has 4px padding on the bottom
                    it has 8px padding on the left and right
                }
                agentLumen {
                    an AgentRow
                    with a title of "Lumen"
                    with a note of "While you were away: the flaky checkout test is fixed."
                    with a tint of "#111110"
                }
                agentOncall {
                    an AgentRow
                    with a title of "Platform on-call"
                    with a note of "Two pages overnight, both resolved and written up."
                    with a tint of "#F26B1D"
                }
                agentWeb {
                    an AgentRow
                    with a title of "Web app"
                    with a note of "Done for this week: 14 patch and minor upgrades."
                    with a tint of "#8B5E3C"
                }
                agentBilling {
                    an AgentRow
                    with a title of "Billing"
                    with a note of "Three failed charges, all expired cards; emails sent."
                    with a tint of "#3B5BDB"
                }
                agentDesign {
                    an AgentRow
                    with a title of "Design review"
                    with a note of "Left six comments; the empty state needs a pass."
                    with a tint of "#8E44C9"
                }
                agentRelease {
                    an AgentRow
                    with a title of "Release train"
                    with a note of "42 pull requests, canary clean, promoted at noon."
                    with a tint of "#2F9E55"
                }
                showMore {
                    a paragraph
                    the text says "Show more"
                    the text is 12px
                    the text is #62615D
                    it has 8px padding on the top
                    it has 8px padding on the left and right
                }
            }

            chat {
                a container

                it stretches its children

                it grows to fill the space
                it has 14px padding
                it has 16px gap between children
                chatBar {
                    a container
                    it arranges its children in a row
                    it spreads its children apart
                    it centers its children vertically
                    chatTitle {
                        a paragraph
                        the text says "Migrate the C++ ledger to Rust"
                        the text is 13px
                        the text is #111110
                    }
                    chatMore {
                        a paragraph
                        the text says "..."
                        the text is 13px
                        the text is #8D8C87
                    }
                }
                promptRow {
                    a container
                    it arranges its children in a row
                    promptBubble {
                        a paragraph
                        the text says "Migrate the C++ ledger to Rust. Keep decimal precision and the existing behavior."
                        the text is 13px
                        the text is #111110
                        the line height is 1.45
                        has a #F1F1EF background
                        has 12px rounded corners
                        it has 10px padding on the top and bottom
                        it has 14px padding on the left and right
                        it is at most 280px wide
                        it sits at the end
                    }
                }
                workedFor {
                    a paragraph
                    the text says "›  Worked for 31s"
                    the text is 12px
                    the text is #8D8C87
                }
                answerOne {
                    a paragraph
                    the text says "The ledger rounds half away from zero on display. I will keep that rule in a Decimal-backed Amount type."
                    the words "Decimal" are code
                    the words "Amount" are code
                    the text is 13px
                    the text is #1C1C1C
                    the line height is 1.5
                }
                answerTwo {
                    a paragraph
                    the text says "All 128 parity tests passed, including rounding boundaries, negative balances, and invalid records."
                    the words "128 parity tests passed" are bold
                    the text is 13px
                    the text is #1C1C1C
                    the line height is 1.5
                }
                answerThree {
                    a paragraph
                    the text says "The pull request is ready for your review."
                    the text is 13px
                    the text is #1C1C1C
                }
                waiting {
                    a container
                    it arranges its children in a row
                    it centers its children vertically
                    it has 8px gap between children
                    it has 12px padding on the top
                    waitingDot {
                        a container
                        it is 7px wide
                        it is 7px tall
                        has fully rounded corners
                        has a #F2994A background
                    }
                    waitingText {
                        a paragraph
                        the text says "Lumen is waiting for instructions"
                        the text is 12px
                        the text is #8D8C87
                    }
                }
                composer {
                    a container
                    it sits at the end
                    it arranges its children in a row
                    it spreads its children apart
                    it centers its children vertically
                    has a 1px #E6E5E1 border
                    has 14px rounded corners
                    it has 10px padding on the top and bottom
                    it has 14px padding on the left and right
                    composerHint {
                        a paragraph
                        the text says "+   Ask Lumen to build features, fix bugs, or work on your code"
                        the text is 12px
                        the text is #8D8C87
                    }
                    composerModel {
                        a paragraph
                        the text says "Model · Medium"
                        the text is 12px
                        the text is #62615D
                    }
                }
            }

            review {
                a container

                it stretches its children

                it is 400px wide
                it does not shrink
                has a 1px #E6E5E1 border on the left
                it has 14px padding
                it has 12px gap between children
                on tablets, it is hidden
                reviewTabs {
                    a container
                    it arranges its children in a row
                    it has 14px gap between children
                    tabPr {
                        a paragraph
                        the text says "PR #142"
                        the text is 12px
                        the text is #111110
                        has a #F1F1EF background
                        has 6px rounded corners
                        it has 3px padding on the top and bottom
                        it has 8px padding on the left and right
                    }
                    tabChanges {
                        a paragraph
                        the text says "Changes"
                        the text is 12px
                        the text is #62615D
                        it has 3px padding on the top and bottom
                    }
                }
                statusRow {
                    a container
                    it arranges its children in a row
                    it spreads its children apart
                    it centers its children vertically
                    openPill {
                        a paragraph
                        the text says "Open"
                        the text is 12px
                        the text is #1E7F45
                        has a #E3F5EA background
                        has 6px rounded corners
                        it has 3px padding on the top and bottom
                        it has 9px padding on the left and right
                    }
                    reviewButton {
                        a paragraph
                        the text says "Review"
                        the text is 12px
                        the text is #111110
                        has a 1px #E6E5E1 border
                        has 6px rounded corners
                        it has 4px padding on the top and bottom
                        it has 10px padding on the left and right
                    }
                }
                repoName {
                    a paragraph
                    the text says "northstar/platform · #142"
                    the text is 12px
                    the text is #8D8C87
                }
                prTitle {
                    a minor heading
                    the text says "Migrate the C++ ledger to Rust"
                    the text is 16px
                    the text is semibold
                    the text is #111110
                }
                prMeta {
                    a paragraph
                    the text says "Opened 2 months ago · 2 files · +25 −4"
                    the words "+25" are #1E7F45
                    the words "−4" are #D64545
                    the text is 12px
                    the text is #8D8C87
                }
                mergeRow {
                    a container
                    it arranges its children in a row
                    it spreads its children apart
                    it centers its children vertically
                    has a 1px #E6E5E1 border
                    has 8px rounded corners
                    it has 8px padding
                    mergeState {
                        a paragraph
                        the text says "Open"
                        the text is 12px
                        the text is #111110
                    }
                    mergeButton {
                        a paragraph
                        the text says "Merge"
                        the text is 12px
                        the text is #FFFFFF
                        has a #111110 background
                        has fully rounded corners
                        it has 5px padding on the top and bottom
                        it has 12px padding on the left and right
                    }
                }
                reviewSections {
                    a container
                    it arranges its children in a row
                    it has 14px gap between children
                    has a 1px #ECEBE7 border on the bottom
                    it has 8px padding on the bottom
                    sectionChanges {
                        a paragraph
                        the text says "Changes 2"
                        the text is 12px
                        the text is #62615D
                    }
                    sectionDescription {
                        a paragraph
                        the text says "Description"
                        the text is 12px
                        the text is #111110
                        has a #F1F1EF background
                        has 6px rounded corners
                        it has 2px padding on the top and bottom
                        it has 8px padding on the left and right
                    }
                    sectionDiscussion {
                        a paragraph
                        the text says "Discussion 0"
                        the text is 12px
                        the text is #62615D
                    }
                }
                prBody {
                    a paragraph
                    the text says "Keeps decimal precision and file formats. All 128 parity tests pass."
                    the text is 13px
                    the text is #1C1C1C
                    the line height is 1.5
                }
            }
        }
    }

    proof {
        a section
        it has 56px padding on the top and bottom
        it has 24px padding on the left and right
        it has 12px gap between children
        logoRow {
            a container
            it is full width
            it is at most 1320px wide
            it is centered
            it arranges its children in a row
            it centers its children vertically
            it has 28px gap between children
            it wraps its children
            lovedTitle {
                a small heading
                the text says "♥  Loved by 20,000+ engineers at"
                the words "♥" are #E5484D
                the text is 16px
                the text weight is 420
                the text is #62615D
