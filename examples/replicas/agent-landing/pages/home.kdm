                    has a 1px #E6E5E1 border
                    has 4px rounded corners
                    it has 4px padding on the top and bottom
                    it has 10px padding on the left and right
                }
            }
        }
        articleGrid {
            a container
            it is full width
            it is at most 1320px wide
            it is centered
            it arranges its children in columns at least 240px wide
            it has 8px gap between children
            articleOne {
                an ArticleCard
                with a figure of "Aspen"
                with a caption of "Scaling agent commits beyond what Git was built for"
                with a title of "Aspen: scaling agent commits beyond what Git was built for"
                with a date of "2026.11.05"
            }
            articleTwo {
                an ArticleCard
                with a figure of "γ ≤ 0.8244"
                with a caption of "A tighter upper bound, found with Lumen"
                with a title of "An improved upper bound for a classic constant"
                with a date of "2026.10.27"
            }
            articleThree {
                an ArticleCard
                with a figure of "22%"
                with a caption of "lower cost per solved task"
                with a title of "Introducing Lumen 1.1"
                with a date of "2026.10.10"
            }
            articleFour {
                an ArticleCard
                with a figure of "39%"
                with a caption of "lower median solving time"
                with a title of "Introducing Lumen 1.0"
                with a date of "2026.09.14"
            }
        }
    }

    closing {
        a section
        it has 110px padding on the top and bottom
        it has 24px padding on the left and right
        it has 24px gap between children
        it centers its children horizontally
        closingTitle {
