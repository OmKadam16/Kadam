                        the text says "59.1%"
                        the text is 13px
                        the text is #111110
                        it is 48px wide
                        the text is right aligned
                    }
                }
                termCodex {
                    a container
                    it arranges its children in a row
                    it centers its children vertically
                    it has 20px gap between children
                    has a 1px #ECEBE7 border on the top
