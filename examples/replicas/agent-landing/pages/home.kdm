        suiteTabs {
            a container
            it arranges its children in a row
            it is centered
            has a #ECECEA background
            has 10px rounded corners
            it has 4px padding
            it has 4px gap between children
            tabDeep {
                a button
                the text says "DeepSWE"
                the text is 13px
                the text weight is 420
                has 8px rounded corners
                it has 7px padding on the top and bottom
                it has 12px padding on the left and right
                the text is #62615D
                has no background
                has a 1px #ECECEA border
                when suite is "deep", the text is #111110
                when suite is "deep", has a #FFFFFF background
                when suite is "deep", has a 1px #111110 border
                when clicked, set suite to "deep"
            }
            tabTerminal {
                a button
                the text says "Terminal-Bench"
                the text is 13px
                the text weight is 420
                has 8px rounded corners
                it has 7px padding on the top and bottom
                it has 12px padding on the left and right
                the text is #62615D
                has no background
                has a 1px #ECECEA border
                when suite is "terminal", the text is #111110
                when suite is "terminal", has a #FFFFFF background
                when suite is "terminal", has a 1px #111110 border
                when clicked, set suite to "terminal"
            }
            tabAtlas {
                a button
                the text says "SWE-Atlas QnA"
                the text is 13px
                the text weight is 420
                has 8px rounded corners
                it has 7px padding on the top and bottom
                it has 12px padding on the left and right
                the text is #62615D
                has no background
                has a 1px #ECECEA border
                when suite is "atlas", the text is #111110
                when suite is "atlas", has a #FFFFFF background
                when suite is "atlas", has a 1px #111110 border
                when clicked, set suite to "atlas"
            }
        }
        benchNote {
            a paragraph
            the text says "Benchmarks: our own runs of three public suites, alongside published results from other teams that we did not run. Method, sources and raw data are linked from the report."
            the words "Method, sources and raw data" are underlined
            the text is 12px
            the text is #62615D
            the line height is 1.55
            the text is centered
            it is at most 570px wide
        }
    }

    howTo {
        a section
        it has 64px padding on the top and bottom
        it has 24px padding on the left and right
        it has 32px gap between children
        howTitle {
            a section heading
            the letter spacing is -1.1px
            the text says "How to use Lumen."
            the text is between 2rem and 2.75rem
            the text weight is 420
            the text is #111110
            it is full width
            it is at most 1320px wide
            it is centered
        }
        ways {
            a container
            it is full width
            it is at most 1320px wide
            it is centered
            it arranges its children in columns at least 300px wide
            it has 12px gap between children

            wayApi {
                a container
                it has 10px gap between children
                apiArt {
                    a container
                    it is full width
                    it is 470px tall
                    has a #B9BDC2 and #E4E5E6 gradient
                    the gradient goes at 180deg
                    has 4px rounded corners
                    it hides overflow
                    it has 96px padding on the top
                    it has 72px padding on the left
                    apiCode {
                        a code block
                        it is full width
                        the text says "curl api.lumen.dev/v3/sessions \\\n  -H \"Authorization: Bearer $LUMEN_KEY\" \\\n  -d '{\"prompt\": \"Fix the flaky checkout test\"}'\n\n{\n  \"session_id\": \"ses_8f21c...\",\n  \"status\": \"running\"\n}"
                        the text is 13px
                        the text is #E8E8E6
                        has a #161616 background
                        has 6px rounded corners on the top left
                        it has 18px padding
                        the line height is 1.7
                        it grows to fill the space
                    }
                }
                apiName {
                    a minor heading
                    the text says "API"
                    the text is 20px
                    the text weight is 420
                    the text is #111110
                    it has 8px padding on the top
                }
                apiText {
                    a paragraph
                    the text says "Start a session from a script, a CI job or your own product. Poll it, stream it, read the result."
                    the text is 16px
                    the text is #8D8C87
                    the line height is 1.5
                }
                apiLink {
                    a link
                    the text says "Read the API docs →"
                    the text is 14px
                    the text is #111110
                    the text is not underlined
                    when clicked, go to "closing"
                }
            }

            wayApp {
                a container
                it has 10px gap between children
                appArt {
                    a container
                    it is full width
                    it is 470px tall
                    has a #BFC6CF and #E8EAEC gradient
                    the gradient goes at 180deg
                    has 4px rounded corners
                    it hides overflow
                    it has 96px padding on the top
                    it has 72px padding on the left
                    appList {
                        a container
                        it is full width
                        it grows to fill the space
                        has a #FFFFFF background
                        has 6px rounded corners on the top left
                        it has 12px padding
                        it has 2px gap between children
                        appToggle {
                            a paragraph
                            the text says "Agents    Teammates"
                            the words "Agents" are bold
                            the text is 13px
                            the text is #111110
                            it has 10px padding on the bottom
                        }
                        appRowOne {
                            a paragraph
                            the text says "Platform on-call\nTeammate · Maya, Sam, Daniel"
                            the text is 13px
                            the text is #111110
                            the line height is 1.45
                            has a 1px #ECEBE7 border on the bottom
                            it has 8px padding on the top and bottom
                        }
                        appRowTwo {
                            a paragraph
                            the text says "●  Port the ledger to Rust\n    Lumen"
                            the words "●" are #3B5BDB
                            the text is 13px
                            the text is #111110
                            the line height is 1.45
                            has a 1px #ECEBE7 border on the bottom
                            it has 8px padding on the top and bottom
                        }
                        appRowThree {
                            a paragraph
                            the text says "●  Fix flaky checkout e2e test\n    Claude Code"
                            the words "●" are #2F9E55
                            the text is 13px
                            the text is #111110
                            the line height is 1.45
                            has a 1px #ECEBE7 border on the bottom
                            it has 8px padding on the top and bottom
                        }
                        appRowFour {
                            a paragraph
                            the text says "●  Add rate limiting to the API\n    Codex"
                            the words "●" are #2F9E55
                            the text is 13px
                            the text is #111110
                            the line height is 1.45
                            it has 8px padding on the top and bottom
                        }
                    }
                }
                appName {
                    a minor heading
                    the text says "App"
                    the text is 20px
                    the text weight is 420
                    the text is #111110
                    it has 8px padding on the top
                }
                appText {
                    a paragraph
                    the text says "Your teammates and your agents in one app. Give an agent a name and a team, and run other coding agents beside it."
                    the text is 16px
                    the text is #8D8C87
                    the line height is 1.5
                }
                appLink {
                    a link
                    the text says "Download the app →"
                    the text is 14px
                    the text is #111110
                    the text is not underlined
                    when clicked, go to "closing"
                }
            }

            wayChat {
                a container
                it has 10px gap between children
                chatArt {
                    a container
                    it is full width
                    it is 470px tall
                    has a #C3C7CC and #EADFD8 gradient
                    the gradient goes at 180deg
                    has 4px rounded corners
                    it hides overflow
                    it has 96px padding on the top
                    it has 72px padding on the left
                    chatCard {
                        a container
                        it is full width
                        it grows to fill the space
                        has a #FFFFFF background
                        has 6px rounded corners on the top left
                        it has 12px padding
                        it has 10px gap between children
                        channel {
                            a paragraph
                            the text says "# engineering"
                            the text is 13px
                            the text is #111110
                        }
                        askLine {
                            a paragraph
                            the text says "Daniel  10:42 AM\n@Lumen make the Q3 reliability review deck from the incident log."
                            the words "@Lumen" are #1E6EF4
                            the text is 13px
                            the text is #111110
                            the line height is 1.45
                        }
                        replyLine {
                            a paragraph
                            the text says "Lumen  APP  10:49 AM\nDone: 12 slides. Uptime was 99.97%; every chart is attached."
                            the text is 13px
                            the text is #111110
                            the line height is 1.45
                        }
                        fileChip {
                            a paragraph
                            the text says "PPTX  Q3-reliability-review.pptx"
                            the words "PPTX" are #D64545
                            the text is 12px
                            the text is #111110
                            has a 1px #ECEBE7 border
                            has 6px rounded corners
                            it has 5px padding on the top and bottom
                            it has 8px padding on the left and right
                            it is as wide as its content
                        }
                    }
                }
                chatName {
                    a minor heading
                    the text says "Slack"
                    the text is 20px
                    the text weight is 420
                    the text is #111110
                    it has 8px padding on the top
                }
                chatText {
                    a paragraph
                    the text says "Mention @Lumen in a thread. It replies with the pull request, the deck or the answer when it is done."
                    the text is 16px
                    the text is #8D8C87
                    the line height is 1.5
                }
                chatLink {
                    a link
                    the text says "Add to Slack →"
                    the text is 14px
                    the text is #111110
                    the text is not underlined
                    when clicked, go to "closing"
                }
            }
        }
    }

    articles {
        a section
        it has 64px padding on the top and bottom
        it has 24px padding on the left and right
        it has 18px gap between children
        articlesBar {
            a container
            it is full width
            it is at most 1320px wide
            it is centered
            it arranges its children in a row
            it spreads its children apart
            it centers its children vertically
            articlesTitle {
                a small heading
                the text says "|  Articles"
                the text is 14px
                the text weight is 420
                the text is #8D8C87
            }
            arrows {
                a container
                it arranges its children in a row
                it has 6px gap between children
