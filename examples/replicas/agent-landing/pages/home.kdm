            logoOne {
                a paragraph
                the text says "Boardwalk"
                the text is 16px
                the text is #8D8C87
            }
            logoTwo {
                a paragraph
                the text says "Superframe"
                the text is 16px
                the text is #8D8C87
            }
            logoThree {
                a paragraph
                the text says "Databank"
                the text is 16px
