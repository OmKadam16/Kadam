kadam 0.3

page "{the title of guide}" for each guide in guides {
    the page background is paper
    the page text is ink
    the page is dark when the system is dark

    top1 {
        a SiteHeader
    }

    layout1 {
        a container
        it is full width
        it is at most 1100px wide
        it is centered
        it arranges its children in a row
        it has 48px gap between children
        it has 40px padding on the top and bottom
        it has 24px padding on the left and right
        on phones, it arranges its children in a column
        on phones, it has 24px gap between children

        sidebar1 {
            a sidebar
            it is 220px wide
            it does not shrink
            it has 6px gap between children
            on phones, it is full width
            sidebarTitle {
                a small heading
                the text says "Guide"
                the text is 13px
                the text is muted
            }
            sidebarLink {
                a GuideLink for each guide in guides
                sorted by the order of guide
                with a title of the title of guide
                with a target of the title of guide
            }
        }

        article1 {
            an article
            it grows to fill the space
            it is at most 720px wide
            it has 14px gap between children
            headline {
                a main heading
                the text says "{the title of guide}"
                the text is between 2rem and 2.5rem
                the letter spacing is -0.8px
            }
            lead1 {
                a paragraph
                the text says "{the summary of guide}"
                the text is 18px
                the text is muted
            }
            body1 {
                a container
                it stretches its children
                it has 14px gap between children
                it shows the document "{the body of guide}"
            }
        }
    }
}
