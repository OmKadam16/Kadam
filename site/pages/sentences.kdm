kadam 0.3

page "Sentences" {
    the page background is paper
    the page text is ink
    the page is dark when the system is dark

    top1 {
        a SiteHeader
    }

    reference {
        a section
        it is full width
        it is at most 900px wide
        it is centered
        it has 40px padding on the top and bottom
        it has 24px padding on the left and right
        it stretches its children
        it has 10px gap between children
        referenceTitle {
            a main heading
            the text says "Every sentence"
            the text is between 2rem and 2.5rem
            the letter spacing is -0.8px
        }
        referenceLead {
            a paragraph
            the text says "This list is generated from the compiler's own templates, so it always matches the language. Run kadam keywords --properties for the property table."
            the words "kadam keywords --properties" are code
            the text is muted
        }
        sentence {
            a SentenceRow for each sentence in sentences
            with a name of the name of sentence
            with a version of the version of sentence
            with an examples of the examples of sentence
        }
    }
}
