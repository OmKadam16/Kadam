// The Kadam documentation site: paper, ink and a deep blue.
kadam 0.3
theme {
    the paper color is #FBFBF9
    the ink color is #16181D
    the muted color is #4E5461
    the brand color is #2747C9
    the tint color is #EEF1FC
    the line color is #E4E5E9
    the surface color is #FFFFFF
    the code color is #F2F3F6
    in dark mode, the paper color is #111318
    in dark mode, the ink color is #ECEEF3
    in dark mode, the muted color is #A6ACB8
    in dark mode, the brand color is #8EA4FF
    in dark mode, the tint color is #1B2140
    in dark mode, the line color is #2A2E38
    in dark mode, the surface color is #171A21
    in dark mode, the code color is #1D2029
}
